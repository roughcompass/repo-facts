# The @repo-facts scope resolves only to the internal registry. When
# REPO_FACTS_NPM_REGISTRY is unset the URL stays unexpanded, so installs of
# @repo-facts packages fail rather than fall back to a public registry.
@repo-facts:registry=${REPO_FACTS_NPM_REGISTRY}
# Lockfiles record version and integrity but no registry URL, so every
# install resolves through the scope mapping above. (replace-registry-host
# would rewrite scoped tarball URLs to the default public registry.)
omit-lockfile-registry-resolved=true
# Never run dependency lifecycle scripts.
ignore-scripts=true
# Credentials are never committed. scripts/lib/registry.mjs writes a
# temporary auth file from REPO_FACTS_NPM_TOKEN when publishing.
