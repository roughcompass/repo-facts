{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@repo-facts/*": [
        "./packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/test/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
